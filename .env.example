# ─── обязательные ─────────────────────────────────────────────
# В Docker / Coolify не трогать — entrypoint выставит файл-БД в volume:
#   DATABASE_URL="file:/app/data/prod.db"
DATABASE_URL="file:./prisma/dev.db"

# Папка для сгенерированных .docx, фото с выездов, ЭДО-пакетов:
STORAGE_DIR="./storage"

# Auth.js — обязательно сгенерировать перед прод-запуском:
#   openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3030"
AUTH_TRUST_HOST="true"   # для деплоя за reverse-proxy

# ─── AI (Anthropic Claude) — опционально ──────────────────────
# Без ключа функции AI вернут понятный 503, остальное работает
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-7"

# ─── SMTP — реальная отправка писем по e-mail ────────────────
# Без креденшелов работает dev-outbox: storage/outbox/*.eml.txt
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='ООО «РКС-НР» <mail@rks-nr.ru>'
DEV_FAKE_SEND="true"   # переключить в "false" чтобы реально отправлять

# ─── IMAP — синхронизация входящих ────────────────────────────
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASS=""
IMAP_FOLDER="INBOX"
IMAP_FROM_ALLOWLIST="ppk-ez.ru,mariupol.gov-dpr.ru"

# ─── WebPush ─────────────────────────────────────────────────
# Сгенерировать ключи:
#   npx tsx scripts/gen-vapid.ts
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:mail@rks-nr.ru"

# ─── Telegram (для дайджеста) ────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_DEFAULT_CHAT=""

# ─── Cron-расписание утреннего дайджеста ──────────────────────
CRON_DAILY_DIGEST="0 9 * * *"

# ─── Сидер при первом старте Docker ───────────────────────────
# true — при пустой БД зальёт демо-данные (рекомендую true для пилота)
SEED_ON_INIT="true"
